# MinuteMate Environment Variables for Railway Deployment

# Required: OpenAI API Key for AI processing
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Database URL (Railway provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Redis URL for caching and rate limiting
# REDIS_URL=redis://localhost:6379/0

# Optional: Secret key for sessions (Railway can generate this)
SECRET_KEY=your-secret-key-here

# Optional: Environment settings
FLASK_ENV=production
PYTHONPATH=backend

# Optional: File upload limits
MAX_CONTENT_LENGTH=104857600

# Optional: Email settings for notifications
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=your-email@gmail.com

# Optional: Calendar integration
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
